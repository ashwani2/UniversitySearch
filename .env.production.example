# Production template for the SOP generator service.
# On the server, copy to `.env.production` and fill in. Never commit the real file.
#
# systemd reads this via EnvironmentFile= (deploy/fly-together-search.service):
# no spaces around `=`, no inline `#` comments after a value.

# nginx proxies search.letsflytogether.com to this port. 4000 is the API, so the
# two must not collide.
PORT=5001

# At least one provider key is required or every /generate-sop call fails.
# The service tries providers in order and falls back down the list.
GROQ_API_KEY=CHANGE_ME
OPENROUTER_API_KEY=CHANGE_ME
OPENROUTER_MODEL=deepseek/deepseek-chat-v3-0324:free
